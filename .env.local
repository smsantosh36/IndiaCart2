# Dashboard login credentials — deployment se pehle inhe zaroor badal dein
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Session cookie ko sign karne ke liye ek random secret string
AUTH_SECRET=dealloop-dev-secret-change-me

# Aapki live site ka URL (WhatsApp/Facebook/Threads share preview links ke liye).
# Deploy karne ke baad apna real Vercel/custom domain yahan daalein, e.g.:
# NEXT_PUBLIC_SITE_URL=https://dealloop.vercel.app
NEXT_PUBLIC_SITE_URL=

# Vercel Blob se image uploads (category/banner/blog/logo) real hosted files ban jaate
# hain — Vercel par "Storage → Create → Blob" connect karne par ye env var apne aap
# add ho jaata hai. Local dev mein khaali chodne par images base64 mein hi save hoti
# hain (chalta hai, bas production jaisi speed nahi milegi).
BLOB_READ_WRITE_TOKEN=
